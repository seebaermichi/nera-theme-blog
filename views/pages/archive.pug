//- All posts (§S4.1, §S11.7): header, body, one section per year (newest
//- first) with the year's count; each row shows day and month (the year is
//- the heading) and the title; the tag-cloud seam at the end.
extends ../layouts/layout.pug

block main
    include ../partials/page-header.pug
    if String(content || '').trim()
        .page__body
            != content
    each group in themeBlog.postsByYear(pageLang({ meta }))
        section.post-archive__year
            h2
                | #{group.year}
                span.post-archive__count #{group.posts.length} #{t('posts')}
            ul.post-archive__list
                each item in group.posts
                    li.post-archive__item
                        time(datetime=isoDate(item.meta.createdAt))= themeBlog.dayMonth(item.meta.createdAt, pageLang(item))
                        a(href=item.meta.href)= item.meta.title
    include ../partials/tag-cloud.pug
