//- The site footer (§S2.2): one quiet line — the footer-extra seam, the
//- legal links of `footer_links`, and the copyright line.
footer.site-footer
    .site-footer__inner
        include footer-extra.pug
        if themeBlog.footerLinks(pageLang({ meta })).length
            nav.site-footer__legal(aria-label=t('Legal'))
                each link in themeBlog.footerLinks(pageLang({ meta }))
                    a(href=link.href)= t(link.label)
        p.site-footer__copy © #{new Date().getFullYear()} #{app.name}
