//- The featured series on the home (§S11.3, `blog.featured_series`): label
//- t('Series'), the name, a link t('Read more') to part one, and the parts
//- as a numbered list. Not rendered when the series has no part in the
//- page's language.
if themeBlog.seriesParts(themeBlog.featuredSeries(), pageLang({ meta })).length
    section.home-series
        div
            p= t('Series')
            h2= themeBlog.featuredSeries()
            a.button(href=themeBlog.seriesParts(themeBlog.featuredSeries(), pageLang({ meta }))[0].meta.href)= t('Read more')
        ol
            each part in themeBlog.seriesParts(themeBlog.featuredSeries(), pageLang({ meta }))
                li
                    a(href=part.meta.href)= part.meta.title
